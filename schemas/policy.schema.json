{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vyane-paw/policy.schema.json",
  "title": "Vyane Paw Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "allowed_tools"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "vyane_route",
          "vyane_dispatch",
          "vyane_broadcast"
        ]
      }
    },
    "allow_failover": {
      "type": "boolean",
      "default": false
    },
    "allow_broadcast": {
      "type": "boolean",
      "default": false
    },
    "max_parallel_targets": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "allowed_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]{1,128}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "allow_failover": {
            "const": true
          }
        },
        "required": [
          "allow_failover"
        ]
      },
      "then": {
        "properties": {
          "allowed_tools": {
            "contains": {
              "const": "vyane_dispatch"
            }
          },
          "allowed_targets": {
            "minItems": 1
          }
        },
        "required": [
          "allowed_targets"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "allow_broadcast": {
            "const": true
          }
        },
        "required": [
          "allow_broadcast"
        ]
      },
      "then": {
        "properties": {
          "allowed_tools": {
            "contains": {
              "const": "vyane_broadcast"
            }
          },
          "allowed_targets": {
            "minItems": 1
          },
          "max_parallel_targets": {
            "minimum": 2
          }
        },
        "required": [
          "allowed_targets",
          "max_parallel_targets"
        ]
      }
    }
  ]
}
