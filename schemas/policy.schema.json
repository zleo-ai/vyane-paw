{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vyane-paw/policy.schema.json",
  "title": "Vyane Paw Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "allowed_tools"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "allowed_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allow_failover": {
      "type": "boolean",
      "default": false
    },
    "allow_broadcast": {
      "type": "boolean",
      "default": false
    },
    "max_parallel_targets": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    }
  }
}
