{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vyane-paw/evidence.schema.json",
  "title": "Vyane Paw Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "sanitization_state",
    "started_at",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scenario": {
      "type": "string",
      "enum": [
        "compatibility",
        "capability_probe",
        "product_entry",
        "qwenpaw_application",
        "durable_workflow",
        "route",
        "failover",
        "failure_isolation",
        "timeout",
        "cancellation",
        "broadcast"
      ]
    },
    "sanitization_state": {
      "type": "string",
      "enum": [
        "sanitized",
        "publishable"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "upstream_revisions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_supported_protocol_versions",
        "discover_probe",
        "negotiated_protocol_version",
        "product_claimed",
        "server_capability_keys",
        "server_instructions_present",
        "server_name",
        "server_version"
      ],
      "properties": {
        "client_supported_protocol_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discover_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "ok",
                "error",
                "transport_failure"
              ]
            },
            "error_code": {
              "type": "integer"
            }
          }
        },
        "negotiated_protocol_version": {
          "type": "string"
        },
        "product_claimed": {
          "type": "array",
          "maxItems": 0
        },
        "server_capability_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "server_instructions_present": {
          "type": "boolean"
        },
        "server_name": {
          "type": "string"
        },
        "server_version": {
          "type": "string"
        }
      }
    },
    "publication_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_type",
        "decision",
        "reviewed_at",
        "source_sha256"
      ],
      "properties": {
        "reviewer_type": {
          "const": "human"
        },
        "decision": {
          "const": "approved"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "durable_workflow"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "app_exit_code",
              "app_process_reaped",
              "daemon_process_reaped",
              "mcp_process_reaped",
              "provider_requests",
              "repeated_cancel_requests",
              "task_log_leaks",
              "terminal_cancelled",
              "workflow_control_readiness_polls",
              "workflow_submitted"
            ],
            "properties": {
              "app_exit_code": {
                "const": 0
              },
              "app_process_reaped": {
                "const": 1
              },
              "daemon_process_reaped": {
                "const": 1
              },
              "mcp_process_reaped": {
                "const": 1
              },
              "provider_requests": {
                "minimum": 1
              },
              "repeated_cancel_requests": {
                "minimum": 2
              },
              "task_log_leaks": {
                "const": 0
              },
              "terminal_cancelled": {
                "const": 1
              },
              "workflow_control_readiness_polls": {
                "type": "integer",
                "minimum": 1
              },
              "workflow_submitted": {
                "const": 1
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "sanitization_state": {
            "const": "publishable"
          }
        },
        "required": [
          "sanitization_state"
        ]
      },
      "then": {
        "required": [
          "publication_review"
        ]
      },
      "else": {
        "not": {
          "required": [
            "publication_review"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "compatibility"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "server_exit_code",
              "server_process_reaped"
            ],
            "properties": {
              "server_exit_code": {
                "const": 0
              },
              "server_process_reaped": {
                "const": 1
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "capability_probe"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "discover_probe_available",
              "discover_probe_completed",
              "product_claimed_extensions",
              "qwenpaw_client_lifecycle_closed",
              "qwenpaw_client_parity",
              "server_advertises_tasks",
              "server_exit_code",
              "server_process_reaped"
            ],
            "properties": {
              "discover_probe_available": {
                "enum": [
                  0,
                  1
                ]
              },
              "discover_probe_completed": {
                "const": 1
              },
              "product_claimed_extensions": {
                "const": 0
              },
              "qwenpaw_client_lifecycle_closed": {
                "const": 1
              },
              "qwenpaw_client_parity": {
                "const": 1
              },
              "server_advertises_tasks": {
                "enum": [
                  0,
                  1
                ]
              },
              "server_exit_code": {
                "const": 0
              },
              "server_process_reaped": {
                "const": 1
              }
            }
          }
        },
        "required": [
          "capabilities",
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "route"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "routing_decision_valid",
              "operator_interventions"
            ],
            "properties": {
              "routing_decision_valid": {
                "const": 1
              },
              "operator_interventions": {
                "const": 0
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "failover"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "fallback_success",
              "fallback_recovery_latency_ms",
              "logical_attempts",
              "primary_http_requests",
              "fallback_http_requests",
              "fallback_duplicate_requests"
            ],
            "properties": {
              "fallback_success": {
                "const": 1
              },
              "fallback_recovery_latency_ms": {
                "minimum": 0
              },
              "logical_attempts": {
                "const": 2
              },
              "primary_http_requests": {
                "minimum": 1
              },
              "fallback_http_requests": {
                "const": 1
              },
              "fallback_duplicate_requests": {
                "const": 0
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "failure_isolation"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "isolated_successes",
              "isolated_failures"
            ],
            "properties": {
              "isolated_successes": {
                "minimum": 1
              },
              "isolated_failures": {
                "minimum": 1
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "timeout"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "timeout_recorded",
              "timeout_duration_ms",
              "timeout_bound_ms"
            ],
            "properties": {
              "timeout_recorded": {
                "const": 1
              },
              "timeout_duration_ms": {
                "minimum": 0
              },
              "timeout_bound_ms": {
                "const": 2500
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "cancellation"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "cancellation_probe_completed",
              "cancellation_propagated"
            ],
            "properties": {
              "cancellation_probe_completed": {
                "const": 1
              },
              "cancellation_propagated": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "broadcast"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "independent_valid_responses",
              "max_observed_concurrency",
              "operator_interventions"
            ],
            "properties": {
              "independent_valid_responses": {
                "minimum": 2
              },
              "max_observed_concurrency": {
                "minimum": 2
              },
              "operator_interventions": {
                "const": 0
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    }
  ]
}
