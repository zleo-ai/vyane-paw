{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vyane-paw/evidence.schema.json",
  "title": "Vyane Paw Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "sanitization_state",
    "started_at",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scenario": {
      "type": "string",
      "enum": [
        "compatibility",
        "route",
        "failover",
        "broadcast"
      ]
    },
    "sanitization_state": {
      "type": "string",
      "enum": [
        "sanitized",
        "publishable"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "upstream_revisions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "compatibility"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "server_exit_code",
              "server_process_reaped"
            ],
            "properties": {
              "server_exit_code": {
                "const": 0
              },
              "server_process_reaped": {
                "const": 1
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    }
  ]
}
