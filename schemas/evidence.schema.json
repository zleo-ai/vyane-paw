{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vyane-paw/evidence.schema.json",
  "title": "Vyane Paw Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "sanitization_state",
    "started_at",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scenario": {
      "type": "string",
      "enum": [
        "compatibility",
        "product_entry",
        "route",
        "failover",
        "failure_isolation",
        "timeout",
        "cancellation",
        "broadcast"
      ]
    },
    "sanitization_state": {
      "type": "string",
      "enum": [
        "sanitized",
        "publishable"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "upstream_revisions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "compatibility"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "server_exit_code",
              "server_process_reaped"
            ],
            "properties": {
              "server_exit_code": {
                "const": 0
              },
              "server_process_reaped": {
                "const": 1
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "route"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "routing_decision_valid",
              "operator_interventions"
            ],
            "properties": {
              "routing_decision_valid": {
                "const": 1
              },
              "operator_interventions": {
                "const": 0
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "failover"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "fallback_success",
              "fallback_recovery_latency_ms",
              "logical_attempts",
              "primary_http_requests",
              "fallback_http_requests",
              "fallback_duplicate_requests"
            ],
            "properties": {
              "fallback_success": {
                "const": 1
              },
              "fallback_recovery_latency_ms": {
                "minimum": 0
              },
              "logical_attempts": {
                "const": 2
              },
              "primary_http_requests": {
                "minimum": 1
              },
              "fallback_http_requests": {
                "const": 1
              },
              "fallback_duplicate_requests": {
                "const": 0
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "failure_isolation"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "isolated_successes",
              "isolated_failures"
            ],
            "properties": {
              "isolated_successes": {
                "minimum": 1
              },
              "isolated_failures": {
                "minimum": 1
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "timeout"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "timeout_recorded",
              "timeout_duration_ms",
              "timeout_bound_ms"
            ],
            "properties": {
              "timeout_recorded": {
                "const": 1
              },
              "timeout_duration_ms": {
                "minimum": 0
              },
              "timeout_bound_ms": {
                "const": 2500
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "cancellation"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "cancellation_probe_completed",
              "cancellation_propagated"
            ],
            "properties": {
              "cancellation_probe_completed": {
                "const": 1
              },
              "cancellation_propagated": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "broadcast"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "independent_valid_responses",
              "max_observed_concurrency",
              "operator_interventions"
            ],
            "properties": {
              "independent_valid_responses": {
                "minimum": 2
              },
              "max_observed_concurrency": {
                "minimum": 2
              },
              "operator_interventions": {
                "const": 0
              }
            }
          }
        },
        "required": [
          "metrics"
        ]
      }
    }
  ]
}
