{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vyane-paw/operation-result.schema.json",
  "title": "Vyane Paw Operation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "mode",
    "policy_profile",
    "operation_status",
    "outcome",
    "detail_state",
    "retry_guidance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "tool": {
      "enum": [
        "vyane_route",
        "vyane_dispatch",
        "vyane_broadcast",
        "vyane_workflow_submit",
        "vyane_workflow_status",
        "vyane_workflow_cancel"
      ]
    },
    "mode": {
      "enum": [
        "route",
        "dispatch",
        "failover",
        "review",
        "workflow-submit",
        "workflow-status",
        "workflow-cancel"
      ]
    },
    "policy_profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "operation_status": {
      "enum": [
        "completed",
        "rejected",
        "protocol_failure",
        "transport_failure"
      ]
    },
    "outcome": {
      "enum": [
        "success",
        "partial",
        "failure",
        "unknown"
      ]
    },
    "detail_state": {
      "enum": [
        "full",
        "receipt",
        "not_applicable"
      ]
    },
    "retry_guidance": {
      "enum": [
        "do_not_retry",
        "check_status_before_retry"
      ]
    },
    "data": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "route"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "const": "vyane_route"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "workflow-submit"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "const": "vyane_workflow_submit"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "workflow-status"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "const": "vyane_workflow_status"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "workflow-cancel"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "const": "vyane_workflow_cancel"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "review"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "const": "vyane_broadcast"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "dispatch",
              "failover"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "const": "vyane_dispatch"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_status": {
            "const": "completed"
          }
        },
        "required": [
          "operation_status"
        ]
      },
      "then": {
        "required": [
          "data"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "data"
          ]
        }
      }
    }
  ]
}
