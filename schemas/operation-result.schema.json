{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vyane-paw/operation-result.schema.json",
  "title": "Vyane Paw Operation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "mode",
    "policy_profile",
    "operation_status",
    "outcome",
    "detail_state",
    "retry_guidance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "tool": {
      "enum": [
        "vyane_route",
        "vyane_dispatch",
        "vyane_broadcast",
        "vyane_workflow_submit",
        "vyane_workflow_status",
        "vyane_workflow_cancel"
      ]
    },
    "mode": {
      "enum": [
        "route",
        "dispatch",
        "failover",
        "review",
        "workflow-submit",
        "workflow-status",
        "workflow-cancel"
      ]
    },
    "policy_profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "operation_status": {
      "enum": [
        "completed",
        "rejected",
        "protocol_failure",
        "transport_failure"
      ]
    },
    "outcome": {
      "enum": [
        "success",
        "partial",
        "failure",
        "unknown"
      ]
    },
    "detail_state": {
      "enum": [
        "full",
        "receipt",
        "not_applicable"
      ]
    },
    "retry_guidance": {
      "enum": [
        "do_not_retry",
        "check_status_before_retry"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "caller_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "cancelling",
            "succeeded",
            "failed",
            "timed_out",
            "cancelled",
            "interrupted"
          ]
        },
        "failure_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "output": {
          "type": "string",
          "maxLength": 65536
        },
        "output_omitted": {
          "type": "boolean"
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caller_id"
      ],
      "properties": {
        "caller_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "route"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "const": "vyane_route"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retry_guidance": {
            "const": "check_status_before_retry"
          }
        },
        "required": [
          "retry_guidance"
        ]
      },
      "then": {
        "required": [
          "correlation"
        ],
        "properties": {
          "tool": {
            "const": "vyane_workflow_submit"
          },
          "operation_status": {
            "const": "rejected"
          },
          "error": {
            "properties": {
              "code": {
                "const": "outcome_unknown"
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "correlation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "workflow-submit"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "const": "vyane_workflow_submit"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "workflow-status"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "const": "vyane_workflow_status"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "workflow-cancel"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "const": "vyane_workflow_cancel"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "review"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "const": "vyane_broadcast"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "dispatch",
              "failover"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "tool": {
            "const": "vyane_dispatch"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_status": {
            "const": "completed"
          }
        },
        "required": [
          "operation_status"
        ]
      },
      "then": {
        "required": [
          "data"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "data"
          ]
        }
      }
    }
  ]
}
