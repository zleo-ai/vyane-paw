{
  "mcpServers": {
    "vyane-paw": {
      "name": "Vyane Paw",
      "description": "Local Vyane routing, failover, bounded multi-model review, and durable workflow control",
      "enabled": true,
      "transport": "stdio",
      "command": "vyane-paw-mcp",
      "args": [],
      "env": {
        "VYANE_PAW_CONFIG": "/absolute/path/to/vyane.toml"
      },
      "tools": [
        "vyane_route",
        "vyane_dispatch",
        "vyane_broadcast",
        "vyane_workflow_submit",
        "vyane_workflow_status",
        "vyane_workflow_cancel"
      ]
    }
  }
}
